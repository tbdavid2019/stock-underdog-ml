# ==============================================================================
# Stock Quantitative Multi-Strategy Platform - Environment Variables
# 專案環境變數設定範本 (請複製為 .env 並填入實際金鑰)
# ==============================================================================

# ==============================================================================
# 1. ☁️ 雲端與本地資料庫設定 (Database Configuration)
# ==============================================================================
# Supabase 雲端資料庫 (必填，用於線上報表與歷史同步)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
# 或發布金鑰 (選填)
SUPABASE_KEY=your_publishable_anon_key_here

# 本地 DuckDB 列式時序庫 (預設啟用，儲存於 data/storage/stock_quant.duckdb)
ENABLE_DUCKDB=true
DUCKDB_PATH=data/storage/stock_quant.duckdb

# ==============================================================================
# 2. 🧠 3 級 Fallback LLM 研報解讀設定 (3-Tier Fallback LLM Configuration)
# ==============================================================================
# 是否啟用 AI 每日操盤解讀生成 (若無 Key 則自動平滑降級為確定性規則模板)
ENABLE_LLM_SUMMARY=true
LLM_TIMEOUT_SECONDS=10

# 🔹 第一順位 (Primary): Google Gemini 2.5 Flash (推薦)
# 取得 API Key: https://aistudio.google.com/
LLM_PRIMARY_NAME=Gemini-Flash
LLM_PRIMARY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_PRIMARY_MODEL=gemini-2.5-flash
LLM_PRIMARY_API_KEY=your_gemini_api_key_here
# 備用簡短變數名稱 (若上述未設定會讀取此項)
# GEMINI_API_KEY=your_gemini_api_key_here

# 🔹 第二順位 (Fallback 1): DeepSeek-V3
# 取得 API Key: https://platform.deepseek.com/
LLM_FALLBACK1_NAME=DeepSeek-V3
LLM_FALLBACK1_BASE_URL=https://api.deepseek.com/v1
LLM_FALLBACK1_MODEL=deepseek-chat
LLM_FALLBACK1_API_KEY=your_deepseek_api_key_here
# 備用簡短變數名稱
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 🔹 第三順位 (Fallback 2): OpenAI GPT-4o-mini 或 自建/轉發 Gateway
# 取得 API Key: https://platform.openai.com/
LLM_FALLBACK2_NAME=OpenAI-Mini
LLM_FALLBACK2_BASE_URL=https://api.openai.com/v1
LLM_FALLBACK2_MODEL=gpt-4o-mini
LLM_FALLBACK2_API_KEY=your_openai_api_key_here
# 備用簡短變數名稱
# OPENAI_API_KEY=your_openai_api_key_here

# ==============================================================================
# 3. 🌐 FastAPI REST API 與 MCP 服務設定 (FastAPI & MCP Server)
# ==============================================================================
# API 伺服器綁定監聽 IP 與 Port (預設 8088 避免衝突)
API_HOST=0.0.0.0
API_PORT=8088

# 安全 CORS 跨來源網域設定 (多網域以逗號分隔；若為 * 則預設禁用 credentials)
# 範例: http://localhost:3000,https://my-dashboard.david888.com
CORS_ORIGINS=*

# ==============================================================================
# 4. 📱 多管道推播通知 (Notification Channels - 選填)
# ==============================================================================
# Discord Webhook 通知
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Telegram Bot 通知
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHANNEL_ID=your_telegram_channel_or_chat_id

# Email SMTP 寄信通知 (Gmail 需使用應用程式密碼)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SENDER_EMAIL=your_sender_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
TO_EMAILS=recipient1@example.com,recipient2@example.com

# ==============================================================================
# 5. ⚙️ 量化運算與硬體加速設定 (Execution & Hardware Acceleration)
# ==============================================================================
# 硬體加速模式: auto (自動偵測 CUDA / MPS / CPU), cuda, mps, cpu
DEVICE=auto

# Docker Hub 自動化 CI/CD 推送 (放置於 GitHub Repository Secrets 中)
# DOCKERHUB_USERNAME=your_dockerhub_username
# DOCKERHUB_TOKEN=your_dockerhub_access_token
